# Etapa 1: compilar la web (genera los HTML estáticos en /app/dist)
FROM node:22-alpine AS builder
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build

# Etapa 2: servirla con Nginx (la imagen final no lleva Node ni node_modules)
FROM nginx:alpine AS final
COPY --from=builder /app/dist /usr/share/nginx/html
COPY ./transversalab.conf /etc/nginx/conf.d/default.conf
COPY ./seguridad.conf /etc/nginx/seguridad.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
